<odoo>
<!-- Global rule: this model is, by definition, a vendor payment only.
     Being global (no group), it is ANDed with every other rule and applies to
     all users (admin included) so that customer receipts (inbound/customer)
     stored in the shared account_payment table are never returned here. -->
<record id="vendor_payment_global_rule" model="ir.rule">
    <field name="name">Vendor Payment - Only Outbound Supplier Payment</field>
    <field name="model_id" ref="model_vendor_payment" />
    <!-- No `groups`: an ir.rule without groups is a global rule (ANDed with
         every group rule and applied to all non-superuser users). -->
    <field
            name="domain_force"
        >['&amp;', ('payment_type', '=', 'outbound'), ('partner_type', '=', 'supplier')]</field>
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
</record>

<!-- Data ownership rules (reuse ssi_financial_accounting vendor payment groups) -->
<record id="vendor_payment_company_rule" model="ir.rule">
    <field name="name">Vendor Payment - Responsible to company data</field>
    <field name="model_id" ref="model_vendor_payment" />
    <field
            name="groups"
            eval="[(4, ref('ssi_financial_accounting.vendor_payment_company_group'))]"
        />
    <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="vendor_payment_companies_rule" model="ir.rule">
    <field
            name="name"
        >Vendor Payment - Responsible to company and all child companies data</field>
    <field name="model_id" ref="model_vendor_payment" />
    <field
            name="groups"
            eval="[(4, ref('ssi_financial_accounting.vendor_payment_company_child_group'))]"
        />
    <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="vendor_payment_all_rule" model="ir.rule">
    <field name="name">Vendor Payment - All</field>
    <field name="model_id" ref="model_vendor_payment" />
    <field
            name="groups"
            eval="[(4, ref('ssi_financial_accounting.vendor_payment_all_group'))]"
        />
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
