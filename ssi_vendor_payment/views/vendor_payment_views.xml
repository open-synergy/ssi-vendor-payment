<odoo>
<!-- Primary tree view rebound to vendor_payment.
     Inherits the core supplier payment tree (not the generic payment tree),
     because that view relabels `partner_id` to "Vendor". -->
<record id="vendor_payment_view_tree" model="ir.ui.view">
    <field name="name">vendor_payment tree</field>
    <field name="model">vendor_payment</field>
    <field name="inherit_id" ref="account.view_account_supplier_payment_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<!-- Primary search view rebound to vendor_payment -->
<record id="vendor_payment_view_search" model="ir.ui.view">
    <field name="name">vendor_payment search</field>
    <field name="model">vendor_payment</field>
    <field name="inherit_id" ref="account.view_account_payment_search" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<!-- Primary form view rebound to vendor_payment.
     The policy button attributes and the Policies page are replicated from
     ssi_financial_accounting.account_payment_view_form, because that view
     inherits the core account.payment form (not this primary view). -->
<record id="vendor_payment_view_form" model="ir.ui.view">
    <field name="name">vendor_payment form</field>
    <field name="model">vendor_payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <xpath expr="//button[@name='action_post']" position="attributes">
            <attribute
                    name="attrs"
                >{'invisible': [('confirm_ok','=',False)]}</attribute>
        </xpath>
        <xpath expr="//button[@name='action_draft']" position="attributes">
            <attribute
                    name="attrs"
                >{'invisible': [('restart_ok','=',False)]}</attribute>
            <attribute name="groups" />
        </xpath>
        <xpath expr="//button[@name='action_cancel']" position="attributes">
            <attribute name="attrs">{'invisible': [('cancel_ok','=',False)]}</attribute>
        </xpath>
        <xpath expr="//button[@name='mark_as_sent']" position="attributes">
            <attribute
                    name="attrs"
                >{'invisible': [('mark_as_sent_ok','=',False)]}</attribute>
        </xpath>
        <xpath expr="//button[@name='unmark_as_sent']" position="attributes">
            <attribute
                    name="attrs"
                >{'invisible': [('unmark_as_sent_ok','=',False)]}</attribute>
        </xpath>
        <xpath expr="//sheet/group[1]" position="after">
            <notebook>
                <page name="policy" string="Policies" groups="base.group_system">
                    <group name="policy_1" colspan="4" col="2">
                        <field name="policy_template_id" groups="base.group_system" />
                        <button
                                name="action_reload_policy_template"
                                type="object"
                                string="Reload Template Policy"
                                class="oe_highlight"
                                icon="fa-refresh"
                            />
                    </group>
                    <group name="policy_2" colspan="4" col="2">
                        <field name="confirm_ok" />
                        <field name="mark_as_sent_ok" />
                        <field name="unmark_as_sent_ok" />
                        <field name="cancel_ok" />
                        <field name="restart_ok" />
                    </group>
                </page>
            </notebook>
        </xpath>
    </field>
</record>

<record id="vendor_payment_action" model="ir.actions.act_window">
    <field name="name">Vendor Payments</field>
    <field name="res_model">vendor_payment</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{
        'default_payment_type': 'outbound',
        'default_partner_type': 'supplier',
        'default_move_journal_types': ('bank', 'cash'),
    }</field>
    <field name="view_id" ref="vendor_payment_view_tree" />
    <field name="search_view_id" ref="vendor_payment_view_search" />
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Register a vendor payment
        </p><p>
            Vendor payments register liquidity movements paid to suppliers.
        </p>
    </field>
</record>

<menuitem
        id="vendor_payment_menu"
        name="Vendor Payments"
        parent="ssi_financial_accounting.menu_account_payable"
        action="vendor_payment_action"
        groups="ssi_financial_accounting.vendor_payment_viewer_group"
        sequence="5"
    />
</odoo>
